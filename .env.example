# Environment variables template
# Copy this file to .env and fill in your actual values

# NextAuth configuration
NEXTAUTH_SECRET="replace-this-with-openssl-rand-base64-32-output"
NEXTAUTH_URL="http://localhost:3000"

# App URL (public access)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase configuration (for storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL database connection
# For Prisma (connection pooling via Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1"
# Direct connection for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Optional: Master encryption key for sensitive data
MASTER_ENCRYPTION_KEY="replace-this-with-openssl-rand-hex-32-output"
